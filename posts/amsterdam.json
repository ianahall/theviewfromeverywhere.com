          "filename": "-1A_3.jpg",
          "src_url": "https://images.squarespace-cdn.com/content/v1/58d6f67f9de4bba5f5e41958/1493780613130-ZAF11TZI5QW3AWSYYGH5/-1A_3.jpg?format=original"
